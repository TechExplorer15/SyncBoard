# =============================================
# SyncBoard — Environment Variables
# =============================================
# Copy this file to .env before running:
#   cp .env.example .env
#
# All values below are safe defaults for local development.
# NEVER commit a .env file with production secrets.
# =============================================

# --- MongoDB ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password123
MONGO_DB=syncboard

# --- Server ---
NODE_ENV=development
PORT=5000

# --- JWT Secrets (change these in production!) ---
JWT_ACCESS_SECRET=dev-access-secret-change-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod

# --- Client ---
VITE_API_URL=http://localhost:5000

# --- CORS ---
CLIENT_ORIGIN=http://localhost:5173
